algoritmo "atividade4 "
 
var
   contador, QHomens, QMulheres: inteiro
   sexo: caractere
   altura, maior, menor, somaMulheres, mediaMulheres: real

 
inicio
   maior <- 0
   menor <- 0
   somaMulheres <- 0
   QHomens <- 0
   QMulheres <- 0
 
   para contador de 1 ate 15 faca
      escreva("Digite a altura: ")
      leia(altura)
 
      escreva("Digite o sexo (M/F): ")
      leia(sexo)
 
   
      se contador = 1 entao
         maior <- altura
         menor <- altura
      senao
         se altura > maior entao
            maior <- altura
        
         se altura < menor entao
            menor <- altura

      se sexo = "M" ou sexo = "m" entao
         QHomens <- QHomens + 1
      
      se sexo = "F" ou sexo = "f" entao
         somaMulheres <- somaMulheres + altura
         QMulheres <- QMulheres + 1
      fimse
      fimse 
      fimse 
      fimse 
      fimse 
 

   fimpara
 
 
   se QMulheres > 0 entao
      mediaMulheres <- somaMulheres / QMulheres
   senao
      mediaMulheres <- 0
   fimse
 
   escreval("Número de homens: ", QHomens)
   escreval("Maior altura: ", maior)
   escreval("Menor altura: ", menor)
   escreval("Média das mulheres: ", mediaMulheres)
 
fimalgoritmo