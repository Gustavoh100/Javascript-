algoritmo " exercicos4"
var
  nota: inteiro
  aluno: inteiro
  nome : caractere
  
inicio
aluno <- 1


  enquanto aluno < 11 faca
    escreval("Digite seu nome :" )
    leia(nome)
    escreval("Digite sua nota: ")
    leia(nota)
    se nota >= 0 e nota < 3 entao
      escreval("nota E  " ,nome)
    senao se nota < 5 entao
      escreval ("nota D " nome )
    senao se nota < 7 entao
      escreval("nota C "nome )
    senao se nota < 9 entao
      escreval("nota B "nome )
    senao se nota < 11 entao
      escreval (" nota A " nome)
    fimse
  fimse
fimse
fimse
fimse

aluno <- aluno + 1
fimenquanto

fimalgoritmo
