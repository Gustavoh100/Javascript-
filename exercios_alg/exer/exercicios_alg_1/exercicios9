algoritmo "atividade9"
var
   n1, n2, op: inteiro
inicio
   escreva("Número 1: ")
   leia(n1)
   escreva("Número 2: ")
   leia(n2)
   escreva("Opção: ")
   leia(op)

   escolha op
      caso 1
         escreval("Média: ", (n1 + n2)/2)
      caso 2
         escreval("Soma: ", n1 + n2)
      caso 3
         escreval("Produto: ", n1 * n2)
      outrocaso
         escreval("Erro - opção inválida")
   fimescolha
fimalgoritmo