algoritmo " exercicos5"
var
  nota: inteiro
  aluno: inteiro
  nome : caractere
  AeB , ConceitoD , ConceitoE : inteiro 
  conceitoC : inteiro
  calculo : real
inicio
  para aluno de 1 ate 10 passo 1 faca
    escreval("Digite seu nome :" )
    leia(nome)
    escreval("Digite sua nota: ")
    leia(nota)
    se nota >= 0 e nota < 3 entao
      escreval("nota E  " ,nome)
    ConceitoE<- ConceitoE+ 1
    senao se nota < 5 entao
      escreval ("nota D ", nome )
    ConceitoD<-ConceitoD+ 1
    senao se nota < 7 entao
      escreval("nota C ",nome )
      conceitoC<- conceitoC +1
    senao se nota < 9 entao
      escreval("nota B ", nome )
     AeB <-AeB +1
    senao se nota < 11 entao
      escreval (" nota A ", nome)
      AeB <-AeB +1
    fimse
  fimse
fimse
fimse
fimse
fimpara
escreval("quantidade de alunos que tiraram A e B :", AeB )
escreval("quantidade de alunos que tiraram D :", ConceitoD)
calculo <- (conceitoE/(ConceitoD+AeB+conceitoC) )*100
escreval("quantidade de alunos que tiraram  E :",  conceitoE, " %")



fimalgoritmo
